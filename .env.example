# === CodeQuest — modelo de variáveis de ambiente ===
# Copie para `.env` e preencha com valores reais. O `.env` NÃO vai para o git.

# Chave da API Anthropic
ANTHROPIC_API_KEY=

# Banco de dados (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=codequest

# Connection string lida pelo ASP.NET. Host=localhost para rodar fora do Docker.
ConnectionStrings__CodeQuest=Host=localhost;Port=5432;Database=codequest;Username=postgres;Password=troque-esta-senha

# Segredo para assinar o cookie de autenticação (valor aleatório longo).
AUTH_COOKIE_SECRET=
