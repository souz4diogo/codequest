# === CodeQuest — modelo de variáveis de ambiente ===
# Copie para `.env` e preencha com valores reais. O `.env` NÃO vai para o git.

# Chave da API do Gemini (motor de IA). Vira config["Gemini:ApiKey"] no ASP.NET.
Gemini__ApiKey=

# Banco de dados (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=codequest

# Connection string lida pelo ASP.NET. Host=localhost para rodar fora do Docker.
ConnectionStrings__CodeQuest=Host=localhost;Port=5432;Database=codequest;Username=postgres;Password=troque-esta-senha

# Segredo para assinar os tokens JWT da API React (aleatório, >= 32 caracteres).
# Ex.: gerar com `openssl rand -base64 48`.
Jwt__Secret=

# Validade do access token (minutos) e do refresh token (dias). Opcionais — padrão 60 e 30.
Jwt__ExpiraEmMinutos=60
Jwt__RefreshExpiraEmDias=30
