@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IGameService Game
@inject ILojaService Loja
@inject IReguladorNivel Nivel

<PageTitle>CodeQuest — Dashboard</PageTitle>

<h1>CodeQuest</h1>

@if (_player is null)
{
    <p>Carregando…</p>
}
else
{
    <section class="stats">
        <div class="card"><span class="rotulo">Jogador</span><strong>@_player.Nome</strong></div>
        <div class="card"><span class="rotulo">Nível</span><strong>@_player.Nivel</strong></div>
        <div class="card"><span class="rotulo">XP</span><strong>@_player.XpTotal</strong></div>
        <div class="card"><span class="rotulo">Gold</span><strong>@_player.Gold</strong></div>
        <div class="card"><span class="rotulo">Streak</span><strong>@_player.StreakDias 🔥</strong></div>
    </section>

    <p class="progresso">
        Faltam <strong>@Nivel.XpFaltandoParaProximoNivel(_player.XpTotal) XP</strong> para o nível @(_player.Nivel + 1).
        @if (_player.PocaoStreakAtiva)
        {
            <span class="pocao">· Poção de streak ativa 🛡️</span>
        }
    </p>

    <div class="acoes">
        <button @onclick="() => AdicionarXp(25)">+25 XP (teste)</button>
        <button @onclick="() => AdicionarXp(60)">+60 XP (teste)</button>
    </div>

    @if (_ultimo is { } r)
    {
        <p class="feedback">
            +@r.XpCreditado XP (base @r.XpBase × @r.Multiplicador.ToString("0.0")), +@r.GoldGanho gold.
            @if (r.SubiuNivel)
            {
                <strong> Subiu para o nível @r.NivelAtual! 🎉</strong>
            }
        </p>
    }

    <h2>Loja</h2>
    <ul class="loja">
        @foreach (var item in _itens)
        {
            <li>
                <span>@item.Nome — @item.CustoGold gold</span>
                <button @onclick="() => Comprar(item.Id)" disabled="@(_player.Gold < item.CustoGold)">Comprar</button>
            </li>
        }
    </ul>
    @if (_erroLoja is not null)
    {
        <p class="erro">@_erroLoja</p>
    }
}

@code {
    private Player? _player;
    private IReadOnlyList<ItemLoja> _itens = [];
    private ResultadoXp? _ultimo;
    private string? _erroLoja;

    protected override async Task OnInitializedAsync() => await Recarregar();

    private async Task Recarregar()
    {
        _player = await Game.ObterPlayerAsync();
        _itens = await Loja.ListarAtivosAsync();
    }

    private async Task AdicionarXp(int xp)
    {
        _erroLoja = null;
        _ultimo = await Game.AdicionarXpAsync(xp);
        await Recarregar();
    }

    private async Task Comprar(int itemId)
    {
        _erroLoja = null;
        var resultado = await Loja.ComprarAsync(itemId);
        if (!resultado.Sucesso)
            _erroLoja = resultado.Erro;
        await Recarregar();
    }
}
