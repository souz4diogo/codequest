@page "/registrar"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IServicoAutenticacao Auth
@inject NavigationManager Nav

<PageTitle>Criar conta — CodeQuest</PageTitle>

<section class="auth">
    <h1>Criar conta</h1>

    <EditForm Model="Input" OnValidSubmit="Cadastrar" FormName="registrar">
        <DataAnnotationsValidator />

        @if (_erro is not null)
        {
            <p class="erro">@_erro</p>
        }

        <label>
            Login
            <InputText @bind-Value="Input.Login" autocomplete="username" />
            <ValidationMessage For="() => Input.Login" />
        </label>

        <label>
            Senha
            <InputText type="password" @bind-Value="Input.Senha" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Senha" />
        </label>

        <button type="submit">Criar conta</button>
    </EditForm>

    <p>Já tem conta? <a href="/login">Entrar</a></p>
</section>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private RegistroModel Input { get; set; } = default!;

    private string? _erro;

    protected override void OnInitialized() => Input ??= new();

    private async Task Cadastrar()
    {
        var resultado = await Auth.RegistrarAsync(Input.Login, Input.Senha);
        if (!resultado.Sucesso || resultado.Valor is not { } usuario)
        {
            _erro = resultado.Erro;
            return;
        }

        // Autentica automaticamente após o registro.
        var principal = ClaimsCodeQuest.ConstruirPrincipal(usuario, usuario.Player!.Id);
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal,
            new AuthenticationProperties { IsPersistent = true });

        Nav.NavigateTo("/");
    }

    public sealed class RegistroModel
    {
        [Required(ErrorMessage = "Informe o login.")]
        [StringLength(40, MinimumLength = 3, ErrorMessage = "Login deve ter entre 3 e 40 caracteres.")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha.")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Senha deve ter ao menos 6 caracteres.")]
        public string Senha { get; set; } = string.Empty;
    }
}
